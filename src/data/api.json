      "name": "Money",
      "kind": "class",
      "module": "@quxkit/billing-kit",
      "summary": "An exact monetary amount: integer minor units in a bigint, tagged with an ISO-4217 currency. Never a JS number, so a float rounding error cannot exist.",
      "members": [
        "Money.fromMinor(minor: bigint | string, currency: string): Money",
