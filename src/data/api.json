      "kind": "class",
      "module": "@quxkit/billing-kit",
      "summary": "A price per unit, in MINOR units (cents), as an exact decimal. A rate of 0.00012 means 0.00012 cents per unit.",
      "members": [
        "Rate.fromDecimalString(value: string): Rate",
        "rate.toDecimalString(): string"
