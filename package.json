{
  "name": "@quxkit/billing-kit-mcp",
  "version": "0.1.1",
  "description": "An MCP server for billing-kit: exact money math, ledger checks, and component discovery for AI assistants.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "billing-kit-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "NOTICE"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node20 --external:@quxkit/billing-kit --external:pg --outfile=dist/index.js --banner:js=\"#!/usr/bin/env node\"",
    "start": "node dist/index.js",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "pretest": "pnpm run build",
    "test": "node --import tsx --test --test-concurrency=1 test/*.test.ts",
    "test:coverage": "c8 node --import tsx --test --test-concurrency=1 test/*.test.ts",
    "discovery:gen": "node scripts/gen-discovery.mjs",
    "discovery:check": "node scripts/gen-discovery.mjs --check",
    "prepublishOnly": "pnpm run lint && pnpm run typecheck && pnpm run build && pnpm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "pg": "^8.23.0",
    "zod": "^3.23.0"
  },
  "peerDependencies": {
    "@quxkit/billing-kit": ">=0.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@quxkit/billing-kit": "link:../billing-kit",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.21.0",
    "c8": "^12.0.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "publishConfig": {
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QuxKit/billing-kit-mcp.git"
  },
  "homepage": "https://github.com/QuxKit/billing-kit-mcp#readme",
  "bugs": {
    "url": "https://github.com/QuxKit/billing-kit-mcp/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts"
}
