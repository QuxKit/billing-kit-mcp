{
  "name": "@quxkit/billing-kit-mcp",
  "version": "0.1.0",
  "description": "An MCP server for billing-kit: exact money math, ledger checks, and component discovery for AI assistants.",
  "type": "module",
  "bin": {
    "billing-kit-mcp": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/index.js --banner:js=\"#!/usr/bin/env node\"",
    "start": "node dist/index.js",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "test:coverage": "c8 node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.23.0"
  },
  "peerDependencies": {
    "@quxkit/billing-kit": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@quxkit/billing-kit": "link:../billing-kit",
    "@types/node": "^22.9.0",
    "c8": "^12.0.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "publishConfig": {
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QuxKit/billing-kit-mcp.git"
  },
  "homepage": "https://github.com/QuxKit/billing-kit-mcp#readme",
  "bugs": {
    "url": "https://github.com/QuxKit/billing-kit-mcp/issues"
  }
}
